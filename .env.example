# wsearch keys. Copy to .env (chmod 600). All keys are optional —
# the router skips providers whose key is missing and falls through
# to keyless ones (youcom, parallel-anon, ddg, tavily-keyless, jina).
# Register (all have free tiers):
#   tavily     — https://app.tavily.com            (1000 credits/mo, keyless fallback)
#   brave      — https://api-dashboard.search.brave.com (free plan)
#   exa        — https://dashboard.exa.ai          ($10/mo ≈ 1400 searches)
#   linkup     — https://www.linkup.so             (top-up)
#   parallel   — https://platform.parallel.ai      (signup grant)
#   firecrawl  — https://firecrawl.dev             (fetch tier, ~2000 credits/mo)
#   z.ai       — https://z.ai                      (web_search_prime MCP; or set ZAI_AUTH_HEADER)

TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
LINKUP_API_KEY=
PARALLEL_API_KEY=
FIRECRAWL_API_KEY=
# ZAI_TOKEN=
# YOUCOM_API_KEY=   # keyed you.com ($100 credit) — free MCP works without it
